PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8788
AI_PORT=8788
OLLAMA_URL=http://localhost:11434
# Compose pulls this model once on first startup; qwen3:30b requires substantial disk and GPU memory.
OLLAMA_MODEL=qwen3:30b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=768

# Optional override. Format: Publisher name|RSS URL,Publisher name|RSS URL
# Defaults include RSS feeds from The Verge, MIT Technology Review, NVIDIA,
# Hugging Face, and Google DeepMind.
# NEWS_FEEDS=The Verge|https://www.theverge.com/rss/ai-artificial-intelligence/index.xml,MIT Technology Review|https://www.technologyreview.com/topic/artificial-intelligence/feed/

# Set this on Cloudflare Pages to the separately hosted API origin.
# VITE_API_BASE_URL=https://news-api.example.com