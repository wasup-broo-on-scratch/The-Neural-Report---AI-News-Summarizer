{
  "name": "the-neural-report",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:ai\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "dev:ai": ".venv/bin/python ai_service/app.py",
    "build": "vite build",
    "deploy:pages": "npx wrangler pages deploy ./dist --project-name=the-neural-report",
    "start": "node server/index.js",
    "test:ai": ".venv/bin/python -m unittest discover -s ai_service -p 'test_*.py'",
    "test": "node --test server/*.test.js && npm run test:ai",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}